# Copy this file to .env (or just export the variable in your shell) and fill in your key.
# Get a key at https://console.anthropic.com -> API Keys.
# NOTE: Spring Boot does not auto-load .env files. Either:
#   export ANTHROPIC_API_KEY=sk-ant-...
# or use a tool like `direnv` / `export $(grep -v '^#' .env | xargs)` to load this file.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# HTTP Basic auth credentials required on every endpoint (see SecurityConfig).
# The application falls back to admin/changeme if these are unset -- fine for
# a laptop, but the app logs a warning and you MUST override them before
# running this anywhere else.
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=changeme

# Directory the MCP filesystem server may read from (see application.yml).
# Defaults to the working directory the app was started from if unset.
MCP_FILESYSTEM_ROOT=.

# Connection string for the read-only Postgres MCP server (see application.yml).
# Note the postgresql:// scheme, not jdbc:postgresql:// -- this is passed
# straight to postgres-mcp, not through the JDBC driver. Defaults to the
# local Docker container's credentials if unset.
POSTGRES_MCP_URL=postgresql://genai:genai@localhost:5434/genai
